# Kopie als terraform.tfvars anlegen (steht in .gitignore). Keine Schlüssel hier:
# der Modellschlüssel kommt nach dem apply per az cli in den Key Vault.
subscription_id  = "00000000-0000-0000-0000-000000000000"
location         = "germanywestcentral"
name_prefix      = "kanfragen"
environment_name = "demo"
key_vault_name   = "kv-kanfragen-demo-01" # weltweit eindeutig, ggf. Suffix ändern
container_image  = "ghcr.io/dangtu1190-tech/kundenanfragen-assistent:latest"
# 1, weil der Zustand in Dateien im Container liegt: zwei Replikate hätten
# getrennte Ergebnisse und einen eigenen Ticketzähler je Replikat.
max_replicas     = 1

# Budget-Alarm: Platzhalter-Adresse und Beispielbetrag, vor einem echten apply anpassen.
budget_alert_email = "budget-alarm@example.invalid"
budget_amount      = 5
budget_start_date  = "2026-10-01T00:00:00Z" # Monatserster, darf beim apply nicht in der Vergangenheit liegen

# Live-Pfad bleibt aus. Anbieterdaten eines eigenen Kontos, kein Firmenzugang eines Arbeitgebers.
live_modellaufrufe = false
llm_provider       = "openai"
llm_base_url       = "https://api.openai.com/v1"
llm_model          = "gpt-4.1-mini"
